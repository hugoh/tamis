amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v3.1.0/hk-config@3.1.0#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
  ...Base.base
  ...Base.shell
  ["cargo_fmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["cargo_clippy"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
    check = "cargo clippy --all-targets --all-features -- -D warnings"
  }
  ["cargo_deny"] {
    glob = List("Cargo.toml", "Cargo.lock", "deny.toml")
    check = "cargo deny check"
  }
  ["cargo_machete"] {
    glob = List("**/*.rs", "Cargo.toml")
    check = "cargo machete"
  }
  ["conventional_commit"] {
    check = "mise run lint-commits"
  }
  ["duplication"] {
    check = "jscpd"
  }
  ["goreleaser"] {
    check = "mise run lint-release"
  }
}

steps = linters

hooks {
  ["pre-commit"] {
    stash = "git"
  }
  ["pre-push"] {
    steps = linters
  }
  ["commit-msg"] {
    steps = new Mapping<String, Step> {
      ["cocogitto_commit_msg"] = Builtins.cocogitto_commit_msg
    }
  }
}
