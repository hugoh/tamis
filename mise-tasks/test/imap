#!/usr/bin/env bash
#MISE description="Run the IMAP client tests against a Dovecot container (Apple's container, Docker or Podman)"
#MISE depends=["test:imap-server"]
set -euo pipefail

runtime=""
name=""
address=""
# shellcheck source=/dev/null
source target/imap-server.env
trap '"$runtime" rm -f "$name" >/dev/null 2>&1 || true' EXIT

TAMIS_TEST_IMAP="$address" cargo nextest run --test imap_dovecot --test cli_dovecot "$@"
