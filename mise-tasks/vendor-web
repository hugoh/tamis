#!/usr/bin/env bash
#MISE description="Copy htmx and Pico.css from npm into internal/web/static/vendor (--check: only verify)"
#USAGE flag "--check" help="fail if the committed files differ from the versions in .config/mise/conf.d/web.toml"
set -euo pipefail

web=internal/web
htmx=$(mise where npm:htmx.org)/node_modules/htmx.org
pico=$(mise where npm:@picocss/pico)/node_modules/@picocss/pico
out=$web/static/vendor
if [ "${usage_check:-false}" = true ]; then
  out=$(mktemp -d)
  trap 'rm -rf "$out"' EXIT
fi

mkdir -p "$out"
cp "$htmx/dist/htmx.min.js" "$out/htmx.min.js"
cp "$htmx/LICENSE" "$out/htmx.LICENSE"
cp "$pico/css/pico.min.css" "$out/pico.min.css"
cp "$pico/LICENSE.md" "$out/pico.LICENSE"

# The repo's end-of-file check wants every file to end in a newline.
for file in "$out/htmx.min.js" "$out/pico.min.css"; do
  [ "$(tail -c1 "$file")" = "" ] || echo >>"$file"
done

if [ "${usage_check:-false}" = true ]; then
  for file in htmx.min.js htmx.LICENSE pico.min.css pico.LICENSE; do
    cmp -s "$out/$file" "$web/static/vendor/$file" || {
      echo "vendored $file is stale: run mise run vendor-web" >&2
      exit 1
    }
  done
fi
