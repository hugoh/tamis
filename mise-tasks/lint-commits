#!/usr/bin/env bash
# DO NOT EDIT — managed by hugoh/go-tools via copier.
#MISE description="Check commit messages are Conventional Commits"
set -euo pipefail

# cog check --from-latest-tag fails with "unable to get any tag" until the
# first release tag exists, which is every brand-new repo's first PR. Before
# then, check the whole history; it's short. cog only counts tags matching
# cog.toml's tag_prefix ("v").
if [ "$(git tag --list 'v*')" != "" ]; then
  exec cog check --from-latest-tag
fi

exec cog check
