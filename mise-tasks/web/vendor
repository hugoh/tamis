#!/usr/bin/env bash
#MISE description="Copy htmx and build the daisyUI/Tailwind stylesheet into web/static/vendor"
#MISE sources=[".config/mise/conf.d/web.toml", "templates/*.html", "web/static/rules.js", "mise-tasks/web/vendor"]
#MISE outputs=["web/static/vendor/htmx.min.js", "web/static/vendor/htmx.LICENSE", "web/static/vendor/theme.css"]
set -euo pipefail

dest=web/static/vendor
mise=${TAMIS_MISE:-mise}
htmx=$("$mise" where npm:htmx.org)/node_modules/htmx.org
cli=$("$mise" where npm:@tailwindcss/cli)/node_modules
tailwind=("$cli"/.mise/tailwindcss@*/node_modules/tailwindcss)
daisyui=$("$mise" where npm:daisyui)/node_modules/daisyui
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
new=$work/new
mkdir -p "$new"

cp "$htmx/dist/htmx.min.js" "$new/htmx.min.js"
cp "$htmx/LICENSE" "$new/htmx.LICENSE"

# Tailwind finds its own files and plugins by walking up from the stylesheet,
# which mise's per-tool install directories defeat: name them by path instead.
# Only the classes the templates use end up in the output.
cat >"$work/input.css" <<CSS
@import "${tailwind[0]}/index.css" source(none);
@plugin "$daisyui";
@source "$PWD/templates";
@source "$PWD/web/static/rules.js";
CSS
log=$work/tailwind.log
"$cli/.bin/tailwindcss" --input "$work/input.css" --output "$new/theme.css" --minify >"$log" 2>&1 || {
  cat "$log"
  exit 1
}
cat "$log"
# A warning here means the optimizer dropped CSS it couldn't parse (tailwind
# 4.3.5 lost daisyUI's .join focus and hover z-index rules this way).
if grep -Eq 'Found [0-9]+ warning' "$log"; then
  echo "tailwind dropped CSS; hold the tailwind or daisyUI bump" >&2
  exit 1
fi

# The repo's end-of-file check wants every file to end in a newline.
for file in "$new/htmx.min.js" "$new/theme.css"; do
  [ "$(tail -c1 "$file")" = "" ] || echo >>"$file"
done

# mise skips this task while its outputs are newer than its sources, so always
# write them: an output left alone would stay older than a touched source and
# the task would run every time.
mkdir -p "$dest"
cp "$new/htmx.min.js" "$new/htmx.LICENSE" "$new/theme.css" "$dest/"
